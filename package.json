{
  "name": "afisha-bashkortostan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.15" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "start": "npm run dev",
    "start:api": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "start:bot": "node --env-file-if-exists=.env apps/bot/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "refresh": "node --env-file-if-exists=.env apps/api/src/refresh.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test apps/*/test/*.test.ts"
  },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
