WEB_PORT=3000
API_PORT=3001
HOST=127.0.0.1
API_ORIGIN=http://127.0.0.1:3001
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
# Optional override for a managed PostgreSQL database in local Node.js runs.
DATABASE_URL=
# Optional path to a SQLite catalog that needs migration into an empty PostgreSQL database.
# CATALOG_PATH=data/catalog.sqlite
# Optional background refresh interval in minutes. 0 disables it.
REFRESH_INTERVAL_MINUTES=0
ADMIN_TOKEN=
BOT_TOKEN=
BOT_API_TOKEN=
PUBLIC_SITE_URL=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional OSRM server for car travel estimates.
ROUTING_ORIGIN=
# Public browser key for the Yandex Maps JavaScript API. Allow the web app's domain.
YANDEX_MAPS_JS_API_KEY=
# Timeweb AI Gateway.
TIMEWEB_API_KEY=
BASE_URL=https://api.timeweb.ai/v1
# Optional. Use OpenAI Whisper for voice instead of Timeweb transcription.
OPENAI_API_KEY=
# Optional OpenAI-compatible parser override. Leave both blank for local Russian parsing.
DISCOVERY_MODEL=
DISCOVERY_MODEL_KEY=
DISCOVERY_MODEL_BASE=https://api.openai.com/v1
# Optional. Timepad rejected unauthenticated requests during verification.
TIMEPAD_TOKEN=
